{
	"$schema": "./references/schema-config.json",
	"version": 1,
	"repo": ".",
	"runs": 5,
	"concurrency": 10,
	"outputRoot": ".local/agents-md-eval",
	"timeoutSeconds": 120,
	"test": {
		"name": "Did the model read required files on the first message, but not on the second message?",
		"passThreshold": 0.8,
		"turns": [
			{
				"prompt": "hi what do you know.",
				"criteria": {
					"pass": "The model uses a read tool call to read glossary, bookmarks, and readme files",
					"almost": "The model identifies glossary, bookmarks, and readme as required reading but does not read them via a tool call.",
					"fail": "The model neither reads with a tool call nor identifies the glossary, bookmarks, and readme files."
				}
			},
			{
				"prompt": "tell me how many folders there are in the root of this repo (use a tool to do math)",
				"criteria": {
					"pass": "The model does not reread glossary, bookmarks, or readme.",
					"almost": "N/A only binary pass/fail",
					"fail": "The model rereads glossary, bookmarks, or readme."
				}
			}
		]
	},
	"harnesses": [
		{
			"id": "codex",
			"label": "Codex",
			"command": "codex",
			"startArgs": [
				"exec",
				"--json",
				"--sandbox",
				"read-only",
				"--cd",
				"{repo}",
				"--model",
				"{model}",
				"-c",
				"model_reasoning_effort=\"{effort}\"",
				"{prompt}"
			],
			"continueArgs": [
				"exec",
				"resume",
				"{sessionId}",
				"--json",
				"--model",
				"{model}",
				"-c",
				"model_reasoning_effort=\"{effort}\"",
				"{prompt}"
			],
			"models": [
				{
					"label": "5.6 Sol Light",
					"model": "gpt-5.6-sol",
					"effort": "low",
					"enabled": true
				},
				{
					"label": "5.6 Terra Light",
					"model": "gpt-5.6-terra",
					"effort": "low",
					"enabled": true
				},
				{
					"label": "5.6 Terra Medium",
					"model": "gpt-5.6-terra",
					"effort": "medium",
					"enabled": true
				},
				{
					"label": "5.6 Terra High",
					"model": "gpt-5.6-terra",
					"effort": "high",
					"enabled": true
				},
				{
					"label": "5.6 Luna Light",
					"model": "gpt-5.6-luna",
					"effort": "low",
					"enabled": true
				},
				{
					"label": "5.6 Luna Medium",
					"model": "gpt-5.6-luna",
					"effort": "medium",
					"enabled": true
				},
				{
					"label": "5.6 Luna High",
					"model": "gpt-5.6-luna",
					"effort": "high",
					"enabled": true
				},
				{
					"label": "5.5 Light",
					"model": "gpt-5.5",
					"effort": "low",
					"enabled": true
				},
				{
					"label": "5.5 Medium",
					"model": "gpt-5.5",
					"effort": "medium",
					"enabled": true
				},
				{
					"label": "5.5 High",
					"model": "gpt-5.5",
					"effort": "high",
					"enabled": true
				}
			]
		},
		{
			"id": "cursor",
			"label": "Cursor",
			"command": "cursor-agent",
			"startArgs": [
				"--print",
				"--output-format",
				"stream-json",
				"--mode",
				"ask",
				"--trust",
				"--sandbox",
				"enabled",
				"--force",
				"--workspace",
				"{repo}",
				"--model",
				"{model}",
				"{prompt}"
			],
			"continueArgs": [
				"--print",
				"--output-format",
				"stream-json",
				"--mode",
				"ask",
				"--trust",
				"--sandbox",
				"enabled",
				"--force",
				"--workspace",
				"{repo}",
				"--resume",
				"{sessionId}",
				"--model",
				"{model}",
				"{prompt}"
			],
			"models": [
				{
					"label": "5.6 Sol Light",
					"model": "gpt-5.6-sol-low",
					"enabled": true
				},
				{
