				},
				{
					"label": "Grok 4.5 High",
					"model": "cursor-grok-4.5-high",
					"enabled": true
				},
				{
					"label": "Composer 2.5",
					"model": "composer-2.5",
					"enabled": true
				},
				{
					"label": "Opus 5 Light",
