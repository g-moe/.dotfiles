{
  "toolbar": {
    "code_actions": false
  },
  "relative_line_numbers": "disabled",
  "rounded_selection": true,
  "cursor_animation": {
    "enabled": false
  },
  "reveal_if_open": true,
  "when_closing_with_no_tabs": "keep_window_open",
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "fixed",
    "active_line_width": 2,
    "line_width": 1,
    "enabled": true
  },
  "ui_font_weight": 300.0,
  "agent_buffer_font_size": 12.0,
  "text_rendering_mode": "platform_default",
  "markdown_preview": {
    "font_size": 12.0,
    "font_family": ".ZedSans",
    "code_font_family": ".ZedSans"
  },
  "ui_font_family": ".ZedSans",
  "agent_ui_font_family": ".ZedSans",
  "agent_buffer_font_family": ".ZedSans",
  "agent_ui_font_size": 13.0,
  "active_pane_modifiers": {
    "border_size": 0.0
  },
  "fullscreen_mode": "native",
  "vim": {
    "cursor_shape": {
      "normal": "bar"
    },
    "toggle_relative_line_numbers": false
  },
  "show_edit_predictions": true,
  "agent_servers": {
    "pi-acp": {
      "default_config_options": {
        "model": "openrouter/z-ai/glm-5.3-flash"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "high",
        "mode": "agent-full-access",
        "model": "gpt-6.1-sol",
        "fast-mode": true
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "medium",
        "fast": false
      },
      "type": "registry"
    }
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "copilot",
    "copilot": {
      "prediction_debounce": 0
    }
  },
  "on_new_window": "launchpad",
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
    "show": true
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
    "enabled": false
  },
  "outline_panel": {
    "indent_size": 8.0,
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "limit_content_width": false,
    "default_height": 350.0,
    "default_width": 640.0,
    "notify_when_agent_waiting": "never",
    "expand_edit_card": false,
    "expand_terminal_card": false,
    "show_turn_stats": true,
    "thinking_display": "always_collapsed",
    "play_sound_when_agent_done": "never",
    "enable_feedback": false,
    "single_file_review": true,
    "threads_sidebar": {
      "position": "left",
      "default_width": 325.0,
      "auto_open": false
    },
    "flexible": false,
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "diff_view_style": "split",
  "git_panel": {
    "scrollbar": {
      "show": "system"
    },
    "show_count_badge": false,
    "diff_stats": true,
    "folder_indicator": "both",
    "file_icons": false,
    "status_style": "icon",
    "entry_primary_click_action": "file_diff",
    "group_by": "staging",
    "dock": "right",
    "tree_view": true
  },
  "ssh_connections": [
    {
      "host": "linux",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/linux"
          ]
        },
        {
          "paths": [
            "/home/linux/.dotfiles"
          ]
        },
        {
          "paths": [
            "/home/linux/code/tradester/tradester-monorepo/./"
          ]
        },
        {
          "paths": [
            "/home/linux/code/tradester/tradester-monorepo/tradester"
          ]
        },
        {
          "paths": [
            "/home/linux/code/tradester/tradester-monorepo/tradester-2"
          ]
        },
        {
          "paths": [
            "/home/linux/code/tradester/tradester-monorepo/tradester-3/./"
          ]
        }
      ]
    },
    {
      "host": "linux",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/linux/code/tradester/tradester-monorepo/tradester-2"
          ]
        }
      ]
    }
  ],
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true,
    "restore_unsaved_buffers": false
  },
  "vim_mode": true,
  "terminal": {
    "flexible": false,
    "dock": "bottom",
    "font_size": 13,
    "font_family": "JetBrains Mono",
    "line_height": {
      "custom": 1.0
    },
    "cursor_shape": "bar",
    "blinking": "on",
    "bell": "off",
    "scroll_multiplier": 0.5,
    "minimum_contrast": 4,
    "font_features": {
      "liga": true,
      "calt": true
    },
    "font_weight": 400,
    "shell": {
      "program": "zsh"
    }
  },
  "reduce_motion": "off",
  "project_panel": {
    "dock": "right",
    "auto_fold_dirs": false,
    "indent_size": 8.0,
    "indent_guides": {
      "show": "never"
    }
  },
  "git": {
    "inline_blame": {
      "enabled": false
    },
    "git_gutter": "hide"
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "close_position": "left"
  },
  "mouse_wheel_zoom": true,
  "gutter": {
    "min_line_number_digits": 1,
    "line_numbers": true,
    "folds": true
  },
  "minimap": {
    "show": "never",
    "thumb": "always"
  },
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": true
    },
    "cursors": true,
    "show": "always",
    "git_diff": true
  },
  "hover_popover_delay": 500,
  "selection_highlight": true,
  "cursor_blink": true,
  "use_system_window_tabs": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_family": "JetBrains Mono",
  "file_types": {
    "C++": [
      "*.cpp"
    ],
    "CSS": [
      "*.css"
    ]
  },
  "colorize_brackets": false,
  "show_whitespaces": "none",
  "format_on_save": "on",
  "wrap_guides": [
    100
  ],
  "preferred_line_length": 80,
  "soft_wrap": "editor_width",
  "base_keymap": "VSCode",
  "ui_font_size": 14.0,
  "buffer_font_size": 13.0,
  "theme": "GitHub Dark Dimmed",
  "close_on_file_delete": true,
  "window_title_separator": "",
  "buffer_font_weight": 350.0,
  "buffer_font_features": {
    "liga": true,
    "calt": true
  },
  "buffer_line_height": {
    "custom": 1.6
  },
  "show_wrap_guides": false,
  "window_title_format": "${projectName}:${branch}",
  "max_tabs": 10,
  "file_scan_exclusions": [
    "**/__pycache__",
    "**/._.DS_Store",
    "**/.DS_Store",
    "**/.git",
    "**/.hg",
    "**/.svn",
    "**/CVS",
    "**/Thumbs.db",
    "..."
  ],
  "formatter": "auto",
  "languages": {
    "Go": {
      "formatter": "language_server",
      "format_on_save": "on",
      "hard_tabs": false
    },
    "TypeScript": {
      "format_on_save": "on"
    },
    "JavaScript": {
      "format_on_save": "on"
    },
    "TSX": {
      "format_on_save": "on"
    }
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "javascript": {
          "preferences": {
            "importModuleSpecifier": "relative",
            "importModuleSpecifierEnding": "js"
          },
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "relative",
            "importModuleSpecifierEnding": "js",
            "preferTypeOnlyAutoImports": true
          },
          "tsserver": {
            "maxTsServerMemory": 8192
          },
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      }
    }
  }
}
