{
  "show_edit_predictions": true,
  "agent_servers": {
    "pi-acp": {
      "default_config_options": {
        "model": "openrouter/z-ai/glm-5.3-flash"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "medium",
        "mode": "agent-full-access",
        "model": "gpt-5.6-sol",
        "fast-mode": true
      },
      "type": "registry"
    },
    "claude-acp": {
      "default_config_options": {
        "effort": "medium",
        "fast": true
      },
      "type": "registry"
    }
  },
  "edit_predictions": {
    "allow_data_collection": "no",
    "provider": "copilot",
    "copilot": {
      "prediction_debounce": 0
    }
  },
  "on_new_window": "empty_tab",
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
    "show": true
  },
  "preview_tabs": {
    "enable_preview_from_file_finder": false,
    "enabled": false
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "show_turn_stats": true,
    "thinking_display": "always_collapsed",
    "play_sound_when_agent_done": "always",
    "enable_feedback": false,
    "single_file_review": true,
    "threads_sidebar": {
      "default_width": 325.0,
      "auto_open": false
    },
    "flexible": false,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "diff_view_style": "split",
  "git_panel": {
    "group_by": "staging",
    "dock": "right",
    "tree_view": true
  },
  "ssh_connections": [
    {
      "host": "linux",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/linux"
          ]
        },
        {
          "paths": [
            "/home/linux/code/tradester/tradester-monorepo/./"
          ]
        },
        {
          "paths": [
            "/home/linux/code/tradester/tradester-monorepo/tradester"
          ]
        },
        {
          "paths": [
            "/home/linux/code/tradester/tradester-monorepo/tradester-2"
          ]
        }
      ]
    },
    {
      "host": "linux",
      "args": [],
      "projects": [
        {
          "paths": [
            "/home/linux/code/tradester/tradester-monorepo/tradester-2"
          ]
        }
      ]
    }
  ],
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "session": {
    "trust_all_worktrees": true,
    "restore_unsaved_buffers": false
  },
  "vim_mode": true,
  "terminal": {
    "font_size": 13,
    "font_family": "JetBrains Mono",
    "line_height": {
      "custom": 1.0
    },
    "cursor_shape": "bar",
    "blinking": "on",
    "bell": "off",
    "scroll_multiplier": 0.5,
    "minimum_contrast": 4,
    "font_features": {
      "liga": true,
      "calt": true
    },
    "font_weight": 400,
    "shell": {
      "program": "zsh"
    }
  },
  "reduce_motion": "on",
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false,
    "indent_size": 4,
    "indent_guides": {
      "show": "always"
    }
  },
  "git": {
    "inline_blame": {
      "enabled": false
    },
    "git_gutter": "hide"
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "close_position": "left"
  },
  "mouse_wheel_zoom": true,
  "gutter": {
    "folds": true
  },
  "minimap": {
    "show": "never",
    "thumb": "always"
  },
  "scrollbar": {
    "axes": {
      "horizontal": false,
      "vertical": true
    },
    "cursors": false,
    "show": "always",
    "git_diff": true
  },
  "hover_popover_delay": 500,
  "selection_highlight": false,
  "cursor_blink": true,
  "use_system_window_tabs": true,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "buffer_font_family": "JetBrains Mono",
  "file_types": {
    "C++": [
      "*.cpp"
    ],
    "CSS": [
      "*.css"
    ]
  },
  "colorize_brackets": false,
  "show_whitespaces": "none",
  "format_on_save": "on",
  "wrap_guides": [
    100
  ],
  "preferred_line_length": 80,
  "soft_wrap": "editor_width",
  "base_keymap": "VSCode",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "GitHub Light",
  "close_on_file_delete": true,
  "window_title_separator": "",
  "buffer_font_weight": 500.0,
  "buffer_font_features": {
    "liga": true,
    "calt": true
  },
  "buffer_line_height": {
    "custom": 1.6
  },
  "show_wrap_guides": true,
  "window_title_format": "${projectName}:${branch}",
  "max_tabs": 10,
  "file_scan_exclusions": [
    "**/__pycache__",
    "**/._.DS_Store",
    "**/.DS_Store",
    "**/.git",
    "**/.hg",
    "**/.svn",
    "**/CVS",
    "**/Thumbs.db",
    "..."
  ],
  "formatter": "auto",
  "languages": {
    "Go": {
      "formatter": "language_server",
      "format_on_save": "on",
      "hard_tabs": false
    },
    "TypeScript": {
      "format_on_save": "on"
    },
    "JavaScript": {
      "format_on_save": "on"
    },
    "TSX": {
      "format_on_save": "on"
    }
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "javascript": {
          "preferences": {
            "importModuleSpecifier": "relative",
            "importModuleSpecifierEnding": "js"
          },
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "relative",
            "importModuleSpecifierEnding": "js",
            "preferTypeOnlyAutoImports": true
          },
          "tsserver": {
            "maxTsServerMemory": 8192
          },
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      }
    }
  }
}
