{
	"$schema": "https://unpkg.com/oxfmt@0.53.0/configuration_schema.json",
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 80,
	"singleQuote": false,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"semi": true,
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"ignorePatterns": [
		"**/*.md",
		"packages/raycast/*/raycast-env.d.ts",
		"packages/theming/output/**",
		"packages/theming/vsce-package/themes/**",
		"vscode/user/settings.json"
	]
}
