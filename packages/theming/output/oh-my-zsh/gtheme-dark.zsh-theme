# Generated by packages/theming/create/apps/oh-my-zsh.ts
function gtheme_machine_color() {
  local color="#101010"
  local config="$HOME/.dotfiles/machine.json"

  if [[ -r "$config" ]]; then
    color=$(command awk -F'"' '$2 == "colorHex" { print $4; exit }' "$config" 2>/dev/null)
  fi

  case "$color" in
    [#][[:xdigit:]][[:xdigit:]][[:xdigit:]][[:xdigit:]][[:xdigit:]][[:xdigit:]]) ;;
    *) color="#101010" ;;
  esac
  print -nr -- "$color"
}

local machine_color=$(command awk -F'"' '$2 == "color" { print $4; exit }' "$HOME/.dotfiles/machine.json" 2>/dev/null)
local user_bg="$(gtheme_machine_color)"
local user_fg='#000000'
[[ "$machine_color" == black || -z "$machine_color" ]] && user_fg='#FFFFFF'
local path_bg="#7c7d8d"
local path_fg='#FFFFFF'
local muted_color="#7c7d8d"
local prompt_color="#7c7d8d"

function prompt_context_line() {
  print -nr -- "%K{${user_bg}}%F{${user_fg}} ⌘ %m %k%f%K{${path_bg}}%F{${path_fg}} %~ %k%f"
}

function parse_git_branch() {
  git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --short HEAD 2>/dev/null
}

function prompt_git_line() {
  local folder branch git_line
  local -i ahead behind
  folder="${PWD:t}"
  branch=$(parse_git_branch)
  git_line="${folder}"

  if [[ -n "$branch" ]]; then
    ahead=0
    behind=0
    local counts
    local -a counts_parts
    counts=$(git rev-list --left-right --count @{upstream}...HEAD 2>/dev/null)
    if [[ -n "$counts" ]]; then
      counts_parts=(${=counts})
      [[ ${counts_parts[1]} == <-> ]] && behind=${counts_parts[1]}
      [[ ${counts_parts[2]} == <-> ]] && ahead=${counts_parts[2]}
    fi

    git_line+=" on ${branch}"
    (( ahead > 0 )) && git_line+=" ↑${ahead}"
    (( behind > 0 )) && git_line+=" ↓${behind}"
  fi

  print -nr -- "$git_line"
}

function prompt_input_line() {
  print -nr -- "%f❯"
}

# The mactop menu bar writes this file on each sample; see
# packages/mac/mactop/internal/app/prompt_stats.go.
zmodload zsh/datetime
local mactop_state_dir="$HOME/.mactop"
[[ "$XDG_STATE_HOME" == /* ]] && mactop_state_dir="$XDG_STATE_HOME/mactop"
local mactop_stats_file="$mactop_state_dir/prompt-stats"

function prompt_system_stats() {
  local stats
  local -a mactop_stats

  if [[ "$OSTYPE" == linux* && -x /usr/local/bin/xfce-system-stats ]]; then
    stats="$(/usr/local/bin/xfce-system-stats --prompt)"
  elif [[ "$OSTYPE" == darwin* && -r "$mactop_stats_file" ]]; then
    # Line 1 is the expiry in Unix seconds, so a stopped menu bar shows nothing.
    mactop_stats=("${(@f)$(<"$mactop_stats_file")}")
    [[ ${mactop_stats[1]} == <-> ]] && (( mactop_stats[1] > EPOCHSECONDS )) &&
      stats="${mactop_stats[2]//\%/%%}"
  fi

  [[ -n "$stats" ]] || return
  print -n -- "%F{${muted_color}}%{\e[73m%}${stats}%{\e[75m%}%f"
}

PROMPT='
$(prompt_context_line)
$(prompt_git_line)
$(prompt_input_line) '
RPROMPT='$(prompt_system_stats)'
